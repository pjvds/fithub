---
/**
 * ConnectionCard — shows a single platform connection's status.
 * "Connect" and "Disconnect" actions are handled server-side via form POST.
 */
import type { Connection } from "@fithub/core";
import { formatRelativeTime } from "../lib/formatters";
import DisconnectButton from "./DisconnectButton";

interface Props {
  connection: Connection;
}

const { connection } = Astro.props;

const platformLabel: Record<string, string> = {
  strava: "Strava",
  apple_health: "Apple Health",
};

const statusBadge: Record<string, { label: string; classes: string }> = {
  active:          { label: "Connected",     classes: "bg-green-100 text-green-800" },
  requires_reauth: { label: "Needs re-auth", classes: "bg-amber-100 text-amber-800" },
  disconnected:    { label: "Disconnected",  classes: "bg-gray-100 text-gray-600" },
};

const badge = statusBadge[connection.status] ?? statusBadge["disconnected"]!;
const label = platformLabel[connection.platform] ?? connection.platform;
const lastSynced = connection.last_synced_at
  ? formatRelativeTime(connection.last_synced_at)
  : "Never synced";
---

<div class="rounded-xl border border-gray-200 bg-white p-5 shadow-sm flex items-start justify-between gap-4">
  <div class="min-w-0">
    <div class="flex items-center gap-2">
      <span class="text-base font-semibold text-gray-900">{label}</span>
      <span class={`inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium ${badge.classes}`}>
        {badge.label}
      </span>
    </div>

    <p class="mt-1 text-sm text-gray-500">Last synced: {lastSynced}</p>

    {connection.last_error && (
      <p class="mt-1 text-sm text-red-600" role="alert">
        Error: {connection.last_error}
      </p>
    )}
  </div>

  <div class="flex-shrink-0 flex flex-col gap-2">
    {connection.status === "disconnected" ? (
      <form method="POST" action={`/api/connections/${connection.platform}/connect`}>
        <button
          type="submit"
          class="inline-flex items-center rounded-lg bg-brand-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-brand-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-brand-600 transition-colors"
        >
          Connect
        </button>
      </form>
    ) : connection.status === "requires_reauth" ? (
      <form method="POST" action={`/api/connections/${connection.platform}/connect`}>
        <button
          type="submit"
          class="inline-flex items-center rounded-lg bg-amber-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-amber-700 transition-colors"
        >
          Re-authenticate
        </button>
      </form>
    ) : null}

    {connection.status !== "disconnected" && (
      <DisconnectButton
        client:load
        platform={connection.platform}
        platformLabel={label}
      />
    )}
  </div>
</div>
