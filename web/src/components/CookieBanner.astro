---
/**
 * CookieBanner — GDPR-style notice, dismissed via sessionStorage so it
 * persists for the tab lifetime but reappears on new sessions.
 * Rendered only if JS hasn't already dismissed it (progressive enhancement).
 */
---

<div
  id="cookie-banner"
  class="fixed bottom-4 left-4 right-4 z-40 mx-auto max-w-2xl rounded-xl border border-gray-200 bg-white p-4 shadow-lg flex flex-col sm:flex-row sm:items-center gap-3"
  role="note"
  aria-label="Cookie notice"
>
  <p class="flex-1 text-sm text-gray-600">
    FitHub uses strictly necessary cookies (session authentication only). No advertising or
    third-party tracking cookies are used.
  </p>
  <button
    id="cookie-dismiss"
    type="button"
    class="inline-flex items-center rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 shrink-0"
  >
    Got it
  </button>
</div>

<script>
  const DISMISSED_KEY = "fithub_cookie_dismissed";
  const banner = document.getElementById("cookie-banner");
  const btn = document.getElementById("cookie-dismiss");

  // Hide immediately if already dismissed in this session
  if (sessionStorage.getItem(DISMISSED_KEY)) {
    banner?.remove();
  }

  btn?.addEventListener("click", () => {
    sessionStorage.setItem(DISMISSED_KEY, "1");
    banner?.remove();
  });
</script>
