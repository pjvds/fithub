---
/**
 * Sync History page (AC-5)
 * Lists recent sync jobs, newest first. Cursor-based "Load more" pagination.
 */
import Layout from "../layouts/Layout.astro";
import SyncHistoryRow from "../components/SyncHistoryRow.astro";
import { createApiClient } from "../lib/api-client";
import type { SyncHistoryResponse } from "@fithub/core";

const correlationId: string = Astro.locals.correlationId;
const apiBaseUrl = import.meta.env.API_BASE_URL ?? "https://api.fithub.space";
const accessToken = Astro.cookies.get("access_token")?.value ?? "";

const cursor = Astro.url.searchParams.get("cursor") ?? undefined;

let data: SyncHistoryResponse = { jobs: [], next_cursor: null };
let fetchError: string | null = null;

try {
  const client = createApiClient({ baseUrl: apiBaseUrl, correlationId, accessToken });
  data = await client.getSyncHistory({
    ...(cursor ? { cursor } : {}),
    limit: 50,
  });
} catch {
  fetchError = "Unable to load sync history. Please refresh.";
}
---

<Layout title="Sync History">
  <div class="mx-auto max-w-4xl px-4 py-10 space-y-6">
    <div class="flex items-center gap-4">
      <a href="/dashboard" class="text-sm text-brand-600 hover:underline">← Dashboard</a>
      <h1 class="text-2xl font-bold text-gray-900">Sync History</h1>
    </div>

    {fetchError ? (
      <div class="rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-700" role="alert">
        {fetchError}
      </div>
    ) : data.jobs.length === 0 ? (
      <div class="rounded-xl border-2 border-dashed border-gray-200 p-10 text-center text-gray-500">
        No sync jobs yet. Connect a platform and trigger a sync from the dashboard.
      </div>
    ) : (
      <div class="overflow-x-auto rounded-xl border border-gray-200 bg-white shadow-sm">
        <table class="min-w-full">
          <thead>
            <tr class="bg-gray-50 text-left text-xs font-semibold uppercase tracking-wide text-gray-500">
              <th class="py-3 pr-4 pl-4">Platform</th>
              <th class="py-3 pr-4">Status</th>
              <th class="py-3 pr-4">Started</th>
              <th class="py-3 pr-4 text-right">Activities</th>
              <th class="py-3 pr-4">Error</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            {data.jobs.map((job) => (
              <SyncHistoryRow job={job} />
            ))}
          </tbody>
        </table>

        {data.next_cursor && (
          <div class="border-t border-gray-100 px-4 py-3 text-center">
            <a
              href={`/sync-history?cursor=${encodeURIComponent(data.next_cursor)}`}
              class="text-sm font-medium text-brand-600 hover:underline"
            >
              Load more
            </a>
          </div>
        )}
      </div>
    )}
  </div>
</Layout>
