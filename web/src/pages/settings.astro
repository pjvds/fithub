---
/**
 * Settings page (AC-8, AC-10)
 * Three sections: Profile, Data Export, Account Deletion.
 */
import Layout from "../layouts/Layout.astro";
import ExportButton from "../components/ExportButton";
import ConfirmDeleteModal from "../components/ConfirmDeleteModal";
import { requireSession } from "../lib/session";
import { createApiClient } from "../lib/api-client";
import type { UserProfile } from "@fithub/core";

requireSession(Astro.cookies, Astro.redirect, import.meta.env.AUTH_WORKER_URL, Astro.request.url);

const correlationId: string = Astro.locals.correlationId;
const apiBaseUrl = import.meta.env.API_BASE_URL ?? "https://api.fithub.space";

let profile: UserProfile | null = null;
let fetchError: string | null = null;

try {
  const client = createApiClient({ baseUrl: apiBaseUrl, correlationId });
  profile = await client.getUserProfile();
} catch {
  fetchError = "Unable to load profile. Please refresh.";
}
---

<Layout title="Settings">
  <div class="mx-auto max-w-2xl px-4 py-10 space-y-10">
    <div class="flex items-center gap-4">
      <a href="/dashboard" class="text-sm text-brand-600 hover:underline">← Dashboard</a>
      <h1 class="text-2xl font-bold text-gray-900">Settings</h1>
    </div>

    <!-- Profile section -->
    <section aria-labelledby="profile-heading" class="rounded-xl border border-gray-200 bg-white p-6 space-y-3">
      <h2 id="profile-heading" class="text-lg font-semibold text-gray-800">Profile</h2>

      {fetchError ? (
        <p class="text-sm text-red-600" role="alert">{fetchError}</p>
      ) : profile ? (
        <dl class="text-sm text-gray-700 space-y-2">
          <div class="flex gap-2">
            <dt class="font-medium text-gray-500 w-24">Email</dt>
            <dd>{profile.email ?? "—"}</dd>
          </div>
          <div class="flex gap-2">
            <dt class="font-medium text-gray-500 w-24">User ID</dt>
            <dd class="font-mono text-xs text-gray-400">{profile.user_id}</dd>
          </div>
          <div class="flex gap-2">
            <dt class="font-medium text-gray-500 w-24">Member since</dt>
            <dd>{new Date(profile.created_at * 1000).toLocaleDateString()}</dd>
          </div>
        </dl>
      ) : null}
    </section>

    <!-- Data Export section -->
    <section aria-labelledby="export-heading" class="rounded-xl border border-gray-200 bg-white p-6 space-y-3">
      <h2 id="export-heading" class="text-lg font-semibold text-gray-800">Data Export</h2>
      <p class="text-sm text-gray-600">
        Request a full export of your FitHub data (profile, connections, sync history,
        activity records). You'll receive an email with a download link when the export is ready.
      </p>
      <ExportButton client:load apiBaseUrl={apiBaseUrl} correlationId={correlationId} />
    </section>

    <!-- Account Deletion section -->
    <section aria-labelledby="delete-heading" class="rounded-xl border border-red-200 bg-red-50 p-6 space-y-3">
      <h2 id="delete-heading" class="text-lg font-semibold text-red-800">Danger Zone</h2>
      <p class="text-sm text-red-700">
        Deleting your account permanently removes all your data. This action cannot be undone.
      </p>
      <ConfirmDeleteModal client:load apiBaseUrl={apiBaseUrl} correlationId={correlationId} />
    </section>
  </div>
</Layout>
