---
/**
 * POST /api/connections/[platform]/connect
 *
 * Initiates a platform OAuth connection. Calls the backend initiate endpoint,
 * which generates a PKCE challenge and returns an authUrl. Redirects the user
 * to that URL to begin the OAuth flow on the platform's auth page.
 *
 * On success: 302 → platform OAuth authorization page
 * On failure: 302 → /dashboard?error=connect_failed
 */
if (Astro.request.method !== "GET" && Astro.request.method !== "POST") {
  return new Response("Method Not Allowed", { status: 405 });
}

const { platform } = Astro.params;
const accessToken = Astro.cookies.get("access_token")?.value ?? "";
const { API_BASE_URL: apiBaseUrl } = await import("@/lib/env");
const correlationId = Astro.locals.correlationId;

try {
  const res = await fetch(`${apiBaseUrl}/api/connections/${platform}/oauth/initiate`, {
    method: "POST",
    headers: {
      "Content-Type": "application/json",
      "Authorization": `Bearer ${accessToken}`,
      "x-correlation-id": correlationId,
    },
  });

  if (!res.ok) {
    const body = await res.text().catch(() => "(unreadable)");
    console.error("[connect] API initiate failed", { status: res.status, body, platform, hasToken: accessToken.length > 0 });
    const params = new URLSearchParams({ error: "connect_failed", _status: String(res.status), _detail: body.slice(0, 200) });
    return Astro.redirect(`/dashboard?${params}`, 302);
  }

  const { authUrl } = await res.json() as { authUrl: string };
  return Astro.redirect(authUrl, 302);
} catch (err) {
  const msg = err instanceof Error ? err.message : String(err);
  console.error("[connect] fetch threw", { msg, platform, hasToken: accessToken.length > 0 });
  const params = new URLSearchParams({ error: "connect_failed", _status: "fetch_error", _detail: msg.slice(0, 200) });
  return Astro.redirect(`/dashboard?${params}`, 302);
}
---
