---
import "../styles/global.css";
import CookieBanner from "../components/CookieBanner.astro";

interface Props {
  title: string;
  description?: string;
  showNav?: boolean;
}

const { title, description = "FitHub — unified fitness data sync platform", showNav = false } = Astro.props;
const user = Astro.locals.user;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title} — FitHub</title>
  </head>
  <body class="min-h-screen bg-gray-50 text-gray-900">
    {showNav && user && (
      <header class="border-b bg-white px-4 py-3 flex items-center justify-between">
        <a href="/dashboard" class="font-semibold text-blue-600">FitHub</a>
        <nav class="flex items-center gap-4 text-sm">
          <a href="/dashboard" class="hover:underline">Dashboard</a>
          <a href="/sync-history" class="hover:underline">Sync History</a>
          <a href="/settings" class="hover:underline">Settings</a>
          <a href="/auth/logout" class="text-gray-500 hover:underline">Sign out</a>
        </nav>
      </header>
    )}
    <slot />
    <CookieBanner />
  </body>
</html>
